# =============================================================================
# Runtime environment for the /app SPA.
# Copy to .env to override. None of these are required — sensible defaults
# are baked into the code.
# =============================================================================

# The map is built PROGRAMMATICALLY (not from a web map): a published vector
# tile layer paints the visible TAZ boundaries (fast, GPU-rendered) and a
# transparent hosted feature layer underneath carries taz_id + geometry for
# hit-testing, selection, and attribute queries. There are therefore two
# AGOL identifiers to set, both must be shared publicly.

# AGOL vector tile layer item id — the visible TAZ boundaries.
VITE_VTL_ITEM_ID=df319a5f8a9f48669fd7786204442600

# AGOL portal URL the items live in. Defaults to www.arcgis.com if unset.
VITE_PORTAL_URL=https://cdot.maps.arcgis.com

# TAZ feature service URL — the transparent query/selection layer. Also used
# for the direct attribute queries that fetch the long ACS / network columns
# for selected TAZs.
VITE_TAZ_LAYER_URL=https://services.arcgis.com/yzB9WM8W0BO3Ql7d/arcgis/rest/services/CDOT_TDM_Calculator_TAZ_Enriched_source_/FeatureServer/0

# =============================================================================
# NOT NEEDED: a Census ACS API key.
#
# The calculator does NOT call api.census.gov at runtime. ACS B08301 commute-
# mode-share data is fetched OFFLINE by scripts/fetch_background_data.py,
# joined into the TAZ table by scripts/prepare_taz.py, and published to the
# AGOL feature layer. The app just reads the pre-joined columns
# (acs_transit_share, acs_drove_alone_share, etc.) from the feature service.
#
# The "no ACS coverage" badges in the UI mean the underlying Census record
# is suppressed for that block group (typical for small/rural geographies
# with low worker counts). An API key doesn't unlock those — they're
# suppressed at the Census source.
#
# If you want to *refresh* the ACS snapshot in the layer, you need a Census
# API key for the OFFLINE pipeline only. See the repo-root .env.example for
# CENSUS_API_KEY and the rebuild instructions.
# =============================================================================
