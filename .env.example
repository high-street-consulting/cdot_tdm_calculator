# =============================================================================
# Offline data pipeline environment.
# Copy to .env (gitignored) and fill in. Only needed if you're regenerating
# the data layer that backs the /app SPA — NOT for running the app itself.
# =============================================================================

# Census ACS API key. Free, instant signup:
#   https://api.census.gov/data/key_signup.html
#
# Required by scripts/fetch_background_data.py to pull B08301 commute mode
# share for every Colorado block group. The script joins this onto the TAZ
# table; scripts/publish_enriched_taz.py then publishes the merged result
# to AGOL. The web app reads pre-joined columns at runtime and never calls
# the Census API directly.
#
# Refresh cycle (only when ACS releases a newer 5-year vintage, ~annual):
#   .venv/bin/python scripts/fetch_background_data.py     # writes data/external/*.csv
#   .venv/bin/python scripts/prepare_taz.py               # joins to TAZ table (smoke test)
#   .venv/bin/python scripts/publish_enriched_taz.py      # publishes to AGOL
CENSUS_API_KEY=

# Override AGOL org used by scripts/publish_enriched_taz.py.
# Defaults to https://hspartner.maps.arcgis.com.
AGOL_URL=
