<?xml version="1.0" encoding="UTF-8"?>
<!--
  CDOT TDM Calculator - IIS configuration.

  This is a purely static site. There is no server-side code, no .NET
  application, and nothing that needs a special application pool identity or
  runtime version. IIS only has to serve files.

  Note there are deliberately NO rewrite rules: the app uses hash-based routing
  (every in-app route is "/#/...", e.g. /#/methodology), so the browser only
  ever requests the directory itself from the server. That means the URL Rewrite
  Module is NOT required - it is not installed by default on IIS, and this
  package avoids depending on it.
-->
<configuration>
  <system.webServer>

    <staticContent>
      <!-- SVG is only present by default from IIS 7.5 onward, and is sometimes
           removed on hardened builds. The <remove> guards against the
           "Cannot add duplicate collection entry" 500 if it IS already defined. -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- ~16 MB of JS/CSS uncompressed, roughly 4 MB gzipped. Static compression
         is a large win here and is safe for pre-hashed, immutable assets. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Everything under /assets is content-hashed by the build (filenames change
       whenever the contents change), so it can be cached indefinitely. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- index.html is NOT hashed and points at the current asset filenames. It
       must never be cached, or browsers will keep loading an old app shell that
       references assets a future update has removed. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
